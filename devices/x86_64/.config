#=================================================
# Twrt x86_64 / R86S 专版硬件与驱动配置 (devices/x86_64/.config)
#=================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# 镜像格式 (BIOS + UEFI 双启动 .img.gz)
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_VMDK_IMAGES=n

# R86S 网卡驱动 (Intel I225/I226 2.5GbE + Mellanox ConnectX-3/4 万兆 SFP+ + Intel 万兆)
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y
CONFIG_PACKAGE_kmod-r8125-rss=y
CONFIG_PACKAGE_kmod-r8126-rss=y
CONFIG_PACKAGE_kmod-r8168=y

# R86S 无线网卡与 AP 支持 (Intel AX200/AX201/AX210 iwlwifi + hostapd/wpa_supplicant)
CONFIG_PACKAGE_kmod-iwlwifi=y
CONFIG_PACKAGE_iwlwifi-firmware-ax200=y
CONFIG_PACKAGE_iwlwifi-firmware-ax201=y
CONFIG_PACKAGE_iwlwifi-firmware-ax210=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_iwinfo=y

# 存储、文件系统与硬件监控 (eMMC / NVMe / F2FS / EXT4 / BTRFS / NTFS3 / exFAT)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_smartmontools=y

# Intel 平台微码、显卡与电源温度传感器 (R86S N5105/N6005)
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_i915-firmware-dmc=y
CONFIG_PACKAGE_acpica-unix=y
CONFIG_PACKAGE_cpupower=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_msr-tools=y
CONFIG_PACKAGE_ethtool=y
