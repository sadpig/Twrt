#!/bin/sh
#====================================================================
# Twrt 首次启动自定义、安全加固与 R86S 性能调优脚本 (99-twrt-security)
# 在 my-default-settings (99-default-settings) 之后执行，完成品牌覆盖与安全收口
#====================================================================

# 1. 品牌与主机名统一为 Twrt
uci -q set system.@system[0].hostname='Twrt'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].links='0'

# 2. 禁用 Kwrt 默认的后台静默 opkg 全量自动更新，防止捆绑包/风险配置被复活
uci -q set wizard.default.autoupgrade_pkg='0' 2>/dev/null || true
if [ -f /etc/crontabs/root ]; then
	sed -i '/51-opkg-upgrade/d' /etc/crontabs/root 2>/dev/null || true
fi

# 3. 修复 root 空密码漏洞：如果 /etc/shadow 中 root 为空密码，写入加密哈希（默认密码: root）
if grep -q '^root::' /etc/shadow 2>/dev/null; then
	sed -i 's|^root::|root:\$1\$TwrtSalt\$yQfUbPXNwm5I6uVSSQMf./:|' /etc/shadow
fi

# 4. 加固 SSH (Dropbear)：由 fw4 拦截 WAN 入站，保持 Interface 为空避免 procd 触发器导致 dropbear 无法启动
uci -q set dropbear.main.enable='1'
uci -q delete dropbear.main.Interface 2>/dev/null || true
uci -q set dropbear.main.PasswordAuth='on'
uci -q set dropbear.main.RootPasswordAuth='on'
uci -q set dropbear.main.Port='22'

# 5. 加固网页终端 ttyd：仅绑定 @lan 内网接口，禁止 0.0.0.0 全网裸奔
if [ -f /etc/config/ttyd ]; then
	uci -q set ttyd.@ttyd[0].interface='@lan'
	uci -q set ttyd.@ttyd[0].command='/bin/login'
fi

# 6. 加固 Nginx：80 端口补充 restrict_locally 内网限制，主机名设为 twrt
if [ -f /etc/config/nginx ]; then
	uci -q set nginx.default_server.server_name='twrt'
	uci -q del_list nginx.default_server.include='restrict_locally'
	uci -q add_list nginx.default_server.include='restrict_locally'
fi

# 7. 开启 Dnsmasq DNS 重绑定攻击防护 (Rebind Protection) 与缓存优化
if [ -f /etc/config/dhcp ]; then
	uci -q set dhcp.@dnsmasq[0].rebind_protection='1'
	uci -q set dhcp.@dnsmasq[0].rebind_localhost='1'
	uci -q set dhcp.@dnsmasq[0].localservice='1'
	uci -q set dhcp.@dnsmasq[0].cachesize='10000'
	uci -q set dhcp.@dnsmasq[0].dnsforwardmax='10000'
fi

# 8. 默认关闭 UPnP 自动打洞（可在 LuCI 界面按需手动开启），开启 ACL 校验
if [ -f /etc/config/upnpd ]; then
	uci -q set upnpd.config.enabled='0' 2>/dev/null || true
	uci -q set upnpd.settings.enabled='0' 2>/dev/null || true
	uci -q set upnpd.settings.check_acl='1' 2>/dev/null || true
fi

# 9. 防火墙开启软/硬件流量卸载 (Flow Offloading)、FullCone NAT 与 TCP BBR (tcpcca='bbr')，并清理 FastNet WAN 暴露规则
if [ -f /etc/config/firewall ]; then
	uci -q delete firewall.fastnet 2>/dev/null || true
	uci -q delete firewall.kulicloud 2>/dev/null || true
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='1'
	uci -q set firewall.@defaults[0].fullcone='1'
	uci -q set firewall.@defaults[0].tcpcca='bbr'
fi

# 10. 默认启用全局数据包转向 (Packet Steering / RPS)
uci -q set network.globals.packet_steering='1'

# 11. 默认启用 Vantage 主题
if [ -d /usr/share/ucode/luci/template/themes/vantage ]; then
	uci -q set luci.main.mediaurlbase='/luci-static/vantage'
fi

# 12. 清理 opkg.auto 中残留的冗余推广包并锁定 ignore 列表
if [ -f /etc/config/opkg ]; then
	for pkg in base-files my-default-settings app-meta-fastnet fastnet luci-app-fastnet luci-i18n-fastnet-zh-cn linkease-app-entry luci-lib-linkeaseauth luci-app-kulicloud luci-app-kuli-helper haproxy quickstart luci-app-quickstart luci-app-istorex luci-app-store aria2-openssl ruby libruby3.4 ruby-bigdecimal ruby-date ruby-digest ruby-enc ruby-io-nonblock ruby-io-wait ruby-ipaddr ruby-openssl ruby-pstore ruby-psych ruby-socket ruby-stringio ruby-yaml; do
		uci -q del_list opkg.auto.ipkg="$pkg" 2>/dev/null || true
		uci -q del_list opkg.ignore.ipkg="$pkg" 2>/dev/null || true
		uci -q add_list opkg.ignore.ipkg="$pkg"
	done
fi
opkg flag hold base-files my-default-settings 2>/dev/null || true

# 13. R86S 网卡硬件卸载与 RX/TX Ring Buffer 环形队列扩容 (igc / igb / mlx4_core 10G SFP+)
for dev in $(ls /sys/class/net/ 2>/dev/null | grep -E '^eth[0-9]+$'); do
	if command -v ethtool >/dev/null 2>&1; then
		drv="$(ethtool -i "$dev" 2>/dev/null | awk '/^driver:/ {print $2}')"
		case "$drv" in
			igc|igb)
				ethtool -G "$dev" rx 4096 tx 4096 2>/dev/null || true
				;;
			mlx4_en|mlx4_core|mlx5_core|ixgbe)
				ethtool -G "$dev" rx 4096 tx 4096 2>/dev/null || true
				;;
		esac
	fi
done

if [ -f /etc/init.d/autocore ] && ! grep -q "mlx4" /etc/init.d/autocore 2>/dev/null; then
	sed -i 's/driver: igc/driver: (igc|igb|mlx4|mlx5|ixgbe)/; s/grep -q "driver:/grep -Eq "driver:/' /etc/init.d/autocore 2>/dev/null || true
fi

# 14. 确保 ZRAM 交换分区启用并挂载
if [ -x /etc/init.d/zram ]; then
	/etc/init.d/zram enable 2>/dev/null || true
	grep -q zram /proc/swaps 2>/dev/null || /etc/init.d/zram start 2>/dev/null || true
fi

# 15. R86S (10G SFP+ / 2.5GbE + 8GB RAM) 内核网络栈与 BBR 性能调优
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/98-twrt-r86s.conf << 'EOF'
# Twrt R86S 10GbE / 2.5GbE 高吞吐与低延迟内核参数调优
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=bbr

# 套接字与 TCP 读写缓冲区 (适配 2.5G/10G 万兆转发与代理吞吐)
net.core.rmem_default=262144
net.core.wmem_default=262144
net.core.rmem_max=33554432
net.core.wmem_max=33554432
net.core.optmem_max=262144
net.ipv4.tcp_rmem=4096 131072 33554432
net.ipv4.tcp_wmem=4096 131072 33554432
net.ipv4.udp_rmem_min=16384
net.ipv4.udp_wmem_min=16384

# 网卡队列、软中断预算与连接队列
net.core.netdev_max_backlog=16384
net.core.netdev_budget=600
net.core.somaxconn=8192
net.ipv4.tcp_max_syn_backlog=8192

# TCP 低延迟与连接复用优化
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_tw_reuse=1
net.ipv4.ip_local_port_range=10240 65535

# Conntrack 表容量与超时回收加速 (8GB 内存充裕)
net.nf_conntrack_max=262144
net.netfilter.nf_conntrack_max=262144
net.netfilter.nf_conntrack_tcp_timeout_established=3600
net.netfilter.nf_conntrack_tcp_timeout_time_wait=30
net.netfilter.nf_conntrack_tcp_timeout_close_wait=15
net.netfilter.nf_conntrack_tcp_timeout_fin_wait=30
net.netfilter.nf_conntrack_udp_timeout=30
net.netfilter.nf_conntrack_udp_timeout_stream=120

# 内存回收与虚拟内存策略
vm.swappiness=10
vm.vfs_cache_pressure=50
EOF

modprobe tcp_bbr 2>/dev/null || true
sysctl -e -p /etc/sysctl.d/98-twrt-r86s.conf >/dev/null 2>&1 || true

# 16. 修补 package-manager.js：过滤 hold 锁定包及 my-default-settings，并在多源同名包时取最高版本
if [ -f /www/luci-static/resources/view/package-manager.js ]; then
	sed -i \
		-e "s/if (!isPkgInstalled(inst) || pkg\.name\.includes('busybox')/if (!isPkgInstalled(inst) || inst.hold || pkg.name.includes('busybox') || pkg.name.includes('my-default-settings')/" \
		-e "s/else if (isPkgInstalled(inst) && compareVersion(pkg\.version, inst\.version) > 0)/else if (isPkgInstalled(inst) \&\& !inst.hold \&\& compareVersion(pkg.version, inst.version) > 0)/" \
		-e "s/dest\.pkgs\[pkg\.name\] = dest\.pkgs\[pkg\.name\] ? dest\.pkgs\[pkg\.name\] : pkg;/dest.pkgs[pkg.name] = (dest.pkgs[pkg.name] \&\& compareVersion(dest.pkgs[pkg.name].version, pkg.version) >= 0) ? dest.pkgs[pkg.name] : pkg;/" \
		/www/luci-static/resources/view/package-manager.js 2>/dev/null || true
fi

uci -q commit
rm -rf /tmp/luci-*
exit 0
